---
import '../styles/global.css';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
  /** ocupa a tela inteira, sem scroll na página (cada página cuida do próprio scroll) */
  telaCheia?: boolean;
}

const { title, description = 'Lugares que visitei e que quero visitar.', telaCheia = false } = Astro.props;
const fullTitle = title ? `${title} · Atlas` : 'Atlas';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🗺️</text></svg>" />
    <title>{fullTitle}</title>
  </head>
  <body class:list={{ 'tela-cheia': telaCheia }}>
    <header class="site">
      <div class:list={['container', { cheio: telaCheia }]}>
        <a class="brand" href={url('/')}>🗺️ Atlas</a>
      </div>
    </header>
    <main class:list={{ container: !telaCheia }}>
      <slot />
    </main>
  </body>
</html>
