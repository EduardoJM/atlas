---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Mapa from '../../components/Mapa.astro';
import { type Lugar, statusLabel, prioridadeLabel, formatarData, estrelas, slugify, url } from '../../lib';

export async function getStaticPaths() {
  const lugares = await getCollection('lugares');
  return lugares.map((lugar) => ({ params: { id: lugar.id }, props: { lugar } }));
}

interface Props {
  lugar: Lugar;
}

const { lugar } = Astro.props;
const d = lugar.data;
const { Content } = await render(lugar);
---

<Base title={d.nome} description={`${d.tipo} em ${d.cidade}, ${d.pais}`}>
  <p class="muted"><a href={url("/")}>← Voltar</a></p>

  <h1>{d.nome}</h1>
  <p class="muted sub">
    <span class="tipo">{d.tipo}</span> · {d.cidade}, {d.pais}
    <span class={`badge ${d.status}`}>{statusLabel[d.status]}</span>
  </p>

  <dl class="info">
    {
      d.data_visita && (
        <div>
          <dt>Visita</dt>
          <dd>{formatarData(d.data_visita)}</dd>
        </div>
      )
    }
    {
      d.nota && (
        <div>
          <dt>Nota</dt>
          <dd class="stars" title={`${d.nota} de 5`}>{estrelas(d.nota)}</dd>
        </div>
      )
    }
    {
      d.prioridade && (
        <div>
          <dt>Prioridade</dt>
          <dd>{prioridadeLabel[d.prioridade]}</dd>
        </div>
      )
    }
    {
      d.tags.length > 0 && (
        <div>
          <dt>Tags</dt>
          <dd class="tags">{d.tags.map((t) => <a class="tag" href={url(`/tags/${slugify(t)}/`)}>{t}</a>)}</dd>
        </div>
      )
    }
  </dl>

  {
    d.imagens.length > 0 && (
      <div class="galeria">
        {d.imagens.map((img, i) => (
          <figure>
            <a href={img.src.src}>
              <Image
                src={img.src}
                alt={img.legenda ?? `${d.nome} — foto ${i + 1}`}
                widths={[400, 800]}
                sizes="(max-width: 600px) 100vw, 320px"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </a>
            {img.legenda && <figcaption class="muted">{img.legenda}</figcaption>}
          </figure>
        ))}
      </div>
    )
  }

  {d.coordenadas && <Mapa lugares={[lugar]} zoom={15} />}

  {lugar.body?.trim() && (
    <article class="conteudo">
      <Content />
    </article>
  )}
</Base>

<style>
  .sub {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }
  .tipo { text-transform: capitalize; }
  .info {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin: 0 0 24px;
  }
  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  dd { margin: 2px 0 0; }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
    margin: 0 0 24px;
  }
  figure { margin: 0; }
  figure img {
    display: block;
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  figcaption {
    font-size: 0.85rem;
    margin-top: 4px;
  }
  .conteudo {
    margin-top: 24px;
    max-width: 68ch;
  }
</style>
